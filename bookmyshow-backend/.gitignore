# ==============================================================================
# BookMyShow Backend - Git Ignore Rules
# ==============================================================================

# 1. Build Outputs & Compiled Binaries
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/
out/
bin/
*.class

# Packaged archives (reproducible build artifacts)
*.jar
*.war
*.ear
*.nar
# Maven wrapper files to keep tracked
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar

# JVM crash logs
hs_err_pid*
replay_pid*

# 2. Environment & Secret Configuration
# Local environment variables and secrets
.env
.env.*
*.env
application-local.properties
application-local.yml
application-local.yaml
application-secret*.properties
application-secret*.yml
application-secret*.yaml

# Keystores, certificates, and private keys
*.jks
*.p12
*.pfx
*.pem
*.key
*.crt

# Preserve safe configuration templates
!.env.example
!.env.template

# 3. Logs & Runtime Temporary Files
logs/
*.log
*.log.*
*.tmp
*.temp
tmp/
temp/
HELP.md

# 4. Code Coverage & Test Reports
jacoco.exec
jacoco-it.exec
.surefire/

# 5. Database Dumps & Container Artifacts
*.dump
*.bak
*.sql.bak
*.sql.gz
docker-compose.override.yml
docker-compose.override.yaml
.docker/

# 6. IDE & Text Editors

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/

### Eclipse / Spring Tool Suite (STS) ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
.metadata/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/
!.vscode/extensions.json

# 7. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
